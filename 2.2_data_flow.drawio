<mxfile host="app.diagrams.net">
  <diagram name="第 1 页" id="qqr51mgLOFzX-yBb0XwA">
    <mxGraphModel dx="2002" dy="1217" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    participant C as EDA Client\n    participant Ctrl as EDAServerController\n    participant SM as SessionManager\n    participant DCP as DCPManager\n    participant SE as SampleEngine\n    participant DP as DataProvider\n\n    rect rgba(227, 242, 253, 0.3)\n        %% 会话建立\n        C-&gt;&gt;+Ctrl: HTTPS Request (Basic Auth)\n        Ctrl-&gt;&gt;+SM: CreateSession()\n        SM--&gt;&gt;-C: Session OK\n    end\n\n    rect rgba(232, 245, 233, 0.3)\n        %% 获取 EqSD\n        C-&gt;&gt;+Ctrl: GET /api/eda/eqsd\n        Ctrl-&gt;&gt;Ctrl: Load EqSDModel\n        Ctrl--&gt;&gt;-C: EqSD XML\n    end\n\n    rect rgba(255, 243, 224, 0.3)\n        %% 创建 DCP\n        C-&gt;&gt;+Ctrl: POST /api/eda/dcp\n        Ctrl-&gt;&gt;+DCP: Create(definition)\n        DCP-&gt;&gt;DCP: Validate()\n        DCP--&gt;&gt;-Ctrl: DataCollectionPlan\n        Ctrl--&gt;&gt;-C: DCPOperationResponse\n    end\n\n    rect rgba(243, 229, 245, 0.3)\n        %% 激活 DCP\n        C-&gt;&gt;+Ctrl: POST /api/eda/dcp/{id}/activate\n        Ctrl-&gt;&gt;+DCP: Activate(dcpId)\n        DCP-&gt;&gt;DCP: State = Active\n        DCP-&gt;&gt;+SE: StartSampling(dcp)\n        SE-&gt;&gt;SE: Start Timer\n        SE--&gt;&gt;-Ctrl: DCPOperationResponse\n        Ctrl--&gt;&gt;-C: DCPOperationResponse\n    end\n\n    rect rgba(236, 239, 241, 0.3)\n        %% 数据采样循环\n        loop Every SamplingInterval\n            SE-&gt;&gt;SE: Timer Tick\n            SE-&gt;&gt;+DP: GetParameterValue(paramId)\n            DP--&gt;&gt;-SE: value\n            SE-&gt;&gt;SE: CreateDataSample()\n            SE-&gt;&gt;DCP: AddSample(sample)\n        end\n    end\n\n    rect rgba(255, 243, 224, 0.3)\n        %% 数据推送\n        loop Every ReportingInterval\n            DCP-&gt;&gt;DCP: CollectSamples()\n            DCP--&gt;&gt;Ctrl: DataSampleCollection\n            Ctrl--&gt;&gt;C: Data Push Response\n        end\n    end\n\n    rect rgba(255, 235, 238, 0.3)\n        %% 停用 DCP\n        C-&gt;&gt;+Ctrl: POST /api/eda/dcp/{id}/deactivate\n        Ctrl-&gt;&gt;+DCP: Deactivate(dcpId)\n        DCP-&gt;&gt;+SE: StopSampling(dcp)\n        SE-&gt;&gt;SE: Stop Timer\n        DCP-&gt;&gt;DCP: State = Inactive\n        DCP--&gt;&gt;-Ctrl: DCPOperationResponse\n        Ctrl--&gt;&gt;-C: DCPOperationResponse\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="nQ73-bkUx98SiB6uByJ4-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
