<mxfile host="app.diagrams.net">
  <diagram name="第 1 页" id="416hKkXgNdKw5RgXMrII">
    <mxGraphModel dx="4003" dy="2433" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    %% 表现层\n    class EDAServerController {\n        +GetEqSD(GetEqSDRequest) GetEqSDResponse\n        +CreateDCP(CreateDCPRequest) DCPOperationResponse\n        +ActivateDCP(string) DCPOperationResponse\n        +DeactivateDCP(string) DCPOperationResponse\n        +DeleteDCP(string) DCPOperationResponse\n        +GetAllDCPs() List~dynamic~\n        -DCPManager _dcpManager\n        -EqSDModel _eqsdModel\n    }\n\n    %% 服务层\n    class SessionManager {\n        +CreateSession(string, string) EDASession\n        +RemoveSession(string) bool\n        +GetSession(string) EDASession?\n        +UpdateSessionActivity(string) void\n        +GetActiveSessionCount() int\n        -Dictionary~string,EDASession~ _sessions\n        -int _maxSessions\n        +event SessionCreated\n        +event SessionRemoved\n    }\n\n    class EDASession {\n        +string SessionId\n        +string ClientId\n        +string? ClientIPAddress\n        +SessionState State\n        +Timestamp CreatedTime\n        +Timestamp LastActivityTime\n        +List~string~ DcpIds\n        +UpdateActivity() void\n        +AttachDCP(string) void\n        +DetachDCP(string) void\n    }\n\n    class DCPManager {\n        +Create(DCPDefinition) DataCollectionPlan\n        +Activate(string) void\n        +Deactivate(string) void\n        +Delete(string) bool\n        +Get(string) DataCollectionPlan?\n        +GetAll() IReadOnlyCollection~DataCollectionPlan~\n        -Dictionary~string,DataCollectionPlan~ _dcps\n    }\n\n    class SampleEngine {\n        +Start() void\n        +Stop() void\n        +StartSampling(DataCollectionPlan) void\n        +StopSampling(DataCollectionPlan) void\n        -DCPManager _dcpManager\n        -Dictionary~string,Timer~ _samplingTimers\n        +event DataSampled\n    }\n\n    %% 业务层\n    class EqSDModel {\n        +string EquipmentId\n        +string EquipmentType\n        +string ModelVersion\n        +SEMIStandardInfo? SEMIStandards\n        +List~ParameterDefinition~ Parameters\n        +List~EventDefinition~ Events\n        +List~TraceDefinition~ Traces\n        +string? CreatedTime\n    }\n\n    class ParameterDefinition {\n        +string ParameterId\n        +string Name\n        +string DataType\n        +string? Unit\n        +double MinValue\n        +double MaxValue\n        +string? Description\n        +bool IsReadOnly\n        +bool IsCritical\n    }\n\n    class EventDefinition {\n        +string EventId\n        +string Name\n        +string EventType\n        +string? Severity\n        +string? Description\n    }\n\n    class TraceDefinition {\n        +string TraceId\n        +string Name\n        +string DataType\n        +double SampleRate\n        +string? Unit\n        +int MaxDuration\n        +string? Description\n    }\n\n    class DataCollectionPlan {\n        +string DcpId\n        +DCPDefinition Definition\n        +DCPState State\n        +Timestamp CreatedTime\n        +Timestamp? ActivatedTime\n        +Timestamp? DeactivatedTime\n        +AddSample(DataSample) void\n        +CollectSamples() DataSampleCollection?\n        -List~DataSample~ SampleBuffer\n    }\n\n    class DCPDefinition {\n        +string DcpId\n        +List~string~ ParameterIds\n        +int SamplingIntervalMs\n        +int ReportingIntervalMs\n        +string? TriggerCondition\n        +string? Description\n        +Validate() void\n    }\n\n    class EqSDSerializer {\n        +static Serialize(EqSDModel) string\n        +static Deserialize(string) EqSDModel\n        +static LoadFromFile(string) EqSDModel\n        +static SaveToFile(EqSDModel, string) void\n    }\n\n    %% 数据层\n    class IParameterProvider {\n        &lt;&lt;interface&gt;&gt;\n        +GetParameterValue(string) object?\n        +SubscribeParameterChange(string, Action~object~) IDisposable\n    }\n\n    class IEventProvider {\n        &lt;&lt;interface&gt;&gt;\n        +SubscribeEvent(string, Action~EventData~) IDisposable\n        +GetEventHistory(string, Timestamp, Timestamp) List~EventData~\n    }\n\n    class ITraceProvider {\n        &lt;&lt;interface&gt;&gt;\n        +StartCapture(string, int) Task~TraceData~\n        +StopCapture(string) void\n    }\n\n    class MockDataProvider {\n        +implements IParameterProvider\n        +implements IEventProvider\n        +implements ITraceProvider\n    }\n\n    %% 基础设施层\n    class TlsCertificateProvider {\n        +TlsCertificateProvider(string, string?)\n        +LoadCertificate() X509Certificate2\n        +ValidateCertificate() bool\n        -string _certificatePath\n        -string? _certificatePassword\n    }\n\n    class PasswordValidator {\n        +PasswordValidator()\n        +PasswordValidator(string, string)\n        +AddCredential(string, string) void\n        +Validate(string, string) bool\n        -Dictionary~string,string~ _credentials\n    }\n\n    class EDAServerConfig {\n        +int Port\n        +string? CertificatePath\n        +string? CertificatePassword\n        +int MaxConcurrentSessions\n        +bool EnableUsernamePasswordAuth\n        +bool EnableCertificateAuth\n        +string? CACertificatePath\n        +string? EqSDModelPath\n        +string? NTPServer\n        +string? LogFilePath\n        +Validate() void\n    }\n\n    %% 通用模型\n    class DCPState {\n        &lt;&lt;enumeration&gt;&gt;\n        Created\n        Activating\n        Active\n        Deactivating\n        Inactive\n        Error\n    }\n\n    class SessionState {\n        &lt;&lt;enumeration&gt;&gt;\n        Active\n        Disconnected\n        Timeout\n        Error\n    }\n\n    class Timestamp {\n        +DateTime Value\n        +static Now() Timestamp\n        +ParseIso8601(string) Timestamp\n        +ToIso8601() string\n        +ToUnixTimeMilliseconds() long\n    }\n\n    class DataSample {\n        +string ParameterId\n        +object Value\n        +Timestamp Timestamp\n        +required string DataType\n        +string? Unit\n        +bool IsGoodQuality\n    }\n\n    class DataSampleCollection {\n        +List~DataSample~ Samples\n        +Timestamp CollectionTimestamp\n        +string DcpId\n    }\n\n    class SEMIStandardInfo {\n        +string E120Version\n        +string E125Version\n        +string E132Version\n        +string E134Version\n        +string E164Version\n    }\n\n    %% 关系\n    EDAServerController --&gt; DCPManager\n    EDAServerController --&gt; EqSDModel\n    SessionManager --&gt; EDASession\n    DCPManager --&gt; DataCollectionPlan\n    DataCollectionPlan --&gt; DCPDefinition\n    DataCollectionPlan --&gt; DataSample\n    DataSampleCollection --&gt; DataSample\n    SampleEngine --&gt; DCPManager\n    SampleEngine --&gt; DataSample\n\n    EqSDModel --&gt; ParameterDefinition\n    EqSDModel --&gt; EventDefinition\n    EqSDModel --&gt; TraceDefinition\n    EqSDModel --&gt; SEMIStandardInfo\n    EqSDSerializer --&gt; EqSDModel\n\n    MockDataProvider ..|&gt; IParameterProvider\n    MockDataProvider ..|&gt; IEventProvider\n    MockDataProvider ..|&gt; ITraceProvider\n\n    EDAServerConfig --&gt; PasswordValidator\n    EDAServerConfig --&gt; TlsCertificateProvider\n\n    SessionManager \&quot;3+\&quot; ..&gt; EDASession : manages\n    DCPManager \&quot;1\&quot; *-- \&quot;n\&quot; DataCollectionPlan : contains\n    EqSDModel \&quot;1\&quot; *-- \&quot;n\&quot; ParameterDefinition : has\n    EqSDModel \&quot;1\&quot; *-- \&quot;n\&quot; EventDefinition : has\n    EqSDModel \&quot;1\&quot; *-- \&quot;n\&quot; TraceDefinition : has&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="NZPPFZEXmw3su-86euV2-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
